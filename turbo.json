{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AI_DATABASE_URL",
    "AI_TEST_DATABASE_URL",
    "HABIT_DATABASE_URL",
    "IDENTITY_DATABASE_URL",
    "NOTIFICATION_DATABASE_URL",
    "PLANNING_DATABASE_URL",
    "PRIVACY_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
