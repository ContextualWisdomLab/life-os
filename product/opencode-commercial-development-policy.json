  "maximum_changed_files": 24,
  "maximum_changed_bytes": 131072,
  "maximum_changed_lines": 3000,
  "maximum_prompt_bytes": 32768,
  "maximum_issue_body_bytes": 16384,
  "maximum_issue_title_bytes": 512,
  "maximum_open_pull_requests": 100,
