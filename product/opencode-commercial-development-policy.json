{
  "schema": "life-os.opencode-commercial-development-policy.v1",
  "eligible_issue_titles": [
    "Add durable Today workspace synchronization with optimistic concurrency"
  ],
  "excluded_issue_numbers": [21],
  "allowed_path_prefixes": [
    "apps/",
    "packages/",
    "docs/",
    "product/"
  ],
  "allowed_root_files": [
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "prohibited_path_prefixes": [
    ".github/",
    ".git/",
    "packages/commercial-development-agent/",
    "infra/",
    "coverage/",
    "dist/",
    "build/",
    "node_modules/"
  ],
  "prohibited_exact_paths": [
    ".env",
    ".env.example",
    "SECURITY.md",
    "CODEOWNERS",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "product/opencode-commercial-development-policy.json"
